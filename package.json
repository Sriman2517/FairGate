{
  "name": "fairgate",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "npm run dev --workspace @fairgate/api",
    "dev:web": "npm run dev --workspace @fairgate/web",
    "test:auth": "npm run test:auth --workspace @fairgate/api",
    "test:bookings": "npm run test:bookings --workspace @fairgate/api",
    "test:waiting-room": "npm run test:waiting-room --workspace @fairgate/api",
    "test:request-limits": "npm run test:request-limits --workspace @fairgate/api",
    "test:operations": "npm run test:operations --workspace @fairgate/api",
    "operator:set": "npm run operator:set --workspace @fairgate/api --",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "start": "npm run start:api",
    "start:api": "npm run start --workspace @fairgate/api",
    "start:web": "npm run start --workspace @fairgate/web",
    "db:start": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:generate": "npm run db:generate --workspace @fairgate/api",
    "db:deploy": "npm run db:deploy --workspace @fairgate/api",
    "db:migrate": "npm run db:migrate --workspace @fairgate/api --",
    "db:seed": "npm run db:seed --workspace @fairgate/api",
    "db:studio": "npm run db:studio --workspace @fairgate/api",
    "simulate:traffic": "npm run simulate:traffic --workspace @fairgate/api --",
    "test:traffic": "npm run test:traffic --workspace @fairgate/api",
    "test": "npm run test:traffic && npm run test:auth && npm run test:bookings && npm run test:waiting-room && npm run test:request-limits && npm run test:operations",
    "check": "npm run typecheck && npm test && npm run build"
  }
}
