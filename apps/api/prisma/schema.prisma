generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  INR
}

enum UserRole {
  CUSTOMER
  OPERATOR
}

model Movie {
  id              String @id
  title           String
  synopsis        String
  language        String
  durationMinutes Int
  shows           Show[]
}

model Show {
  id           String   @id
  movieId      String
  cinemaName   String
  screenName   String
  startsAt     DateTime @db.Timestamptz(3)
  priceInPaise Int
  currency     Currency @default(INR)
  movie        Movie    @relation(fields: [movieId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  seats        ShowSeat[]

  @@index([movieId, startsAt])
  @@index([startsAt, id])
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(CUSTOMER)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  sessions     Session[]
  bookings     Booking[]
}

model Session {
  tokenHash String   @id @db.Char(64)
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ShowSeat {
  showId  String
  label   String   @db.VarChar(12)
  row     String   @db.Char(1)
  number  Int
  show    Show     @relation(fields: [showId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  booking Booking?

  @@id([showId, label])
  @@unique([showId, row, number])
}

model Booking {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  showId       String
  seatLabel    String   @db.VarChar(12)
  requestId    String   @db.Uuid
  priceInPaise Int
  currency     Currency @default(INR)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  seat         ShowSeat @relation(fields: [showId, seatLabel], references: [showId, label], onDelete: Restrict, onUpdate: Cascade)

  @@unique([showId, seatLabel])
  @@unique([userId, requestId])
  @@index([userId, createdAt])
}
