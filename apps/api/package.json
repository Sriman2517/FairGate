{
  "name": "@fairgate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "prisma generate && tsc --project tsconfig.check.json",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "test:auth": "prisma generate && tsx --test tests/auth.test.ts",
    "test:bookings": "prisma generate && tsx --test tests/bookings.test.ts",
    "test:waiting-room": "prisma generate && tsx --test tests/waiting-room.test.ts",
    "test:request-limits": "prisma generate && tsx --test tests/request-limits.test.ts",
    "test:operations": "prisma generate && tsx --test tests/operations.test.ts",
    "operator:set": "tsx prisma/set-operator.ts",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.44.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "8.7.0",
    "redis": "6.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "prisma": "7.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
