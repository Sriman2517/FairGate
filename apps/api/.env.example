# Local development credentials for compose.yaml.
DATABASE_URL=postgresql://fairgate:fairgate_dev@127.0.0.1:5433/fairgate
# Optional override; this loopback URL is also the API default.
REDIS_URL=redis://127.0.0.1:6380
# Local defaults. Production defaults to HOST=0.0.0.0 and requires REDIS_URL.
HOST=127.0.0.1
PORT=4000
# All API replicas sharing an auth budget must use the same namespace.
AUTH_LIMIT_NAMESPACE=main
