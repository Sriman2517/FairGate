# Copy to .env.deploy at the repository root; .gitignore excludes that file.
# These are placeholders, not usable credentials. No quotes in a Docker env file.
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
AUTH_LIMIT_NAMESPACE=fairgate-demo

# Neon: retain certificate verification. URL-encode special password characters.
# The runtime may use the pooled hostname; migration tools use the direct hostname.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLED-HOST.neon.tech/neondb?sslmode=verify-full
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-DIRECT-HOST.neon.tech/neondb?sslmode=verify-full

# Upstash's native Redis TLS connection string, NOT the HTTPS REST URL or token.
REDIS_URL=rediss://default:PASSWORD@YOUR-HOST.upstash.io:6379

# Set this separately in Vercel after Render has supplied the API's public URL.
FAIRGATE_API_URL=https://YOUR-API.onrender.com
